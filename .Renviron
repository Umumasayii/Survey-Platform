# LOCAL RUN-APP CONFIGURATION — excluded from rsconnect publishing by .rscignore
# Uses a local PostgreSQL service. The app creates the database/schema/tables automatically.
SAP_RUNTIME_PROFILE=production
SAP_DEMO_MODE=false
SAP_DB_REQUIRED=true
SAP_AUTH_REQUIRED=true
SAP_ALLOW_GUEST=true
SAP_ALLOW_SIGNUP=true
SAP_REQUIRE_SIGNUP_APPROVAL=true
SAP_EMAIL_VERIFICATION_ENABLED=false
SAP_REQUIRE_EMAIL_VERIFICATION=false
SAP_BOOTSTRAP_FIRST_ADMIN=true

SAP_PG_HOST=localhost
SAP_PG_PORT=5432
SAP_PG_DB=nexus_studio
SAP_PG_USER=postgres
SAP_PG_PASSWORD=BRANCHALEE
SAP_PG_SCHEMA=sap
SAP_PG_SSLMODE=disable
SAP_PG_CONNECT_TIMEOUT=5
SAP_PG_AUTO_CREATE_DB=true
SAP_PG_AUTO_CREATE_SCHEMA=true
SAP_STARTUP_ALLOW_DEMO_FALLBACK=false

