# R Shiny Project .gitignore

# History files
.Rhistory
.Rapp.history

# Session Data files
.RData
.RDataTmp

# User-specific files
.Ruserdata

# Example code in package build process
*-Ex.R

# Output files from R CMD build
/*.tar.gz

# Output files from R CMD check
/*.Rcheck/

# RStudio files
.Rproj.user/
.Rproj
*.Rproj

# produced vignette files
vignettes/*.html
vignettes/*.pdf

# OAuth2 token, see https://github.com/hadley/httr/releases/tag/v0.3
.httr-oauth

# knitr and R markdown default cache directories
*_cache/
/cache/

# Temporary files created by R markdown
*.utf8.md
*.knit.md

# R Environment Variables
.Renviron

# Shiny specific
rsconnect/
.shiny_bundle/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS specific
.DS_Store
Thumbs.db

# Large data files (if needed)
data/raw/*
!data/raw/.gitkeep
!data/examples/

# Temporary files
temp/
tmp/
*.tmp

# Logs
*.log

# Dependency lock files (optional - uncomment if you use renv)
# renv.lock

# Python environments (for any Python code)
venv/
env/
__pycache__/
*.pyc

# Node modules (if using any JS build tools)
node_modules/
package-lock.json

# Personal notes
notes/
TODO.md
NOTES.md

# Build output
build/
dist/

# Keep these directories even if empty
!data/examples/.gitkeep
!reports/templates/.gitkeep
!www/images/.gitkeep
